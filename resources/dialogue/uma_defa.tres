[resource]
script = ExtResource("1")
speaker = ""
lines = Array[String](["乌玛：喔咦！那边那个呆瓜！", "阿特：你俩来干嘛？打劫吗，要钱没有，要命一条", "乌玛：阿法跟我说，他爸带他去巴尔城的时候，看到巨神像亮了！", "乌玛：他说他爸也看见了，这绝对是真的，我们要不要去看看？", "阿特：啊？真的假的？那玩意都几百……几千年了吧？", "德法：是真的。白光，大概是神像左后方的地面传来的，在晚上的时候", "阿特：那地方除了教团应该没人去吧？也还没到祭祀的时候啊？", "乌玛：对啊！趁现在大白天的，咱去看看！", "阿特：那你俩跟我一起，帮我把酒拉回去，我跟你们去", "乌玛：简单！", "阿特：阿法，你确定要和我们一起去吗？你爸……没问题吗？", "德法：没事的，我跟他说我去教会帮忙了", "阿特：行吧，那就走吧！"])
